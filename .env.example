# All optional — every value below is the default.

# Port the server listens on. In production it serves the API and the UI together.
PORT=4000

# Where the SQLite file lives. Relative paths resolve from packages/server.
DATABASE_PATH=data/salary.sqlite

# The built web bundle. Served only if the directory exists, so this is harmless
# in development, where Vite serves the UI on its own port instead.
WEB_DIST_PATH=../web/dist

NODE_ENV=development

# Generate the 10,000-employee dataset at startup if the database is empty.
# For hosts with no persistent disk (Render's free tier). Never overwrites existing data.
SEED_ON_BOOT=false
